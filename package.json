{
  "name": "sanity-plugin-link-checker",
  "version": "0.4.0",
  "description": "Scans a Sanity dataset for dangling document references and dead external links, with a Studio tool to review and jump to the offending documents.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "sanity-studio",
    "link-checker",
    "broken-links",
    "dead-links",
    "dangling-references",
    "content-quality",
    "seo"
  ],
  "license": "MIT",
  "author": {
    "name": "Kodamera",
    "url": "https://www.kodamera.se"
  },
  "contributors": [
    "Henrik Larsson"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodamera/sanity-plugin-link-checker.git"
  },
  "homepage": "https://github.com/kodamera/sanity-plugin-link-checker#readme",
  "bugs": {
    "url": "https://github.com/kodamera/sanity-plugin-link-checker/issues"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "default": "./dist/core.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "default": "./dist/index.js"
      },
      "./core": {
        "default": "./dist/core.js"
      },
      "./package.json": "./package.json"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "sanity-plugin-link-checker": "dist/bin/cli.js"
  },
  "files": [
    "dist"
  ],
  "browserslist": "extends @sanity/browserslist-config",
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean && npm run build:cli",
    "build:cli": "node scripts/build-cli.mjs",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "watch": "pkg-utils watch --strict",
    "prepare": "husky"
  },
  "dependencies": {
    "@sanity/client": "^8.6.1",
    "@sanity/id-utils": "^1.0.0",
    "@sanity/ui": "^4.0.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^10.9.2",
    "@sanity/plugin-kit": "^6.0.4",
    "@sanity/semantic-release-preset": "^6.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "conventional-changelog-conventionalcommits": "8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-sanity": "^7.1.4",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanity": "^6.16.0",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.2",
    "sanity": "^6.0.0-0"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": "8.0.0"
  },
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  }
}
